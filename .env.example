# Copy this file to .env.local and fill in your own values.
# Never commit .env.local.

# AMap JavaScript API configuration.
NEXT_PUBLIC_AMAP_KEY=
NEXT_PUBLIC_AMAP_SECURITY_JS_CODE=

# Optional: Bilibili login cookie copied from your browser request headers.
# Keep this secret. A secondary account is recommended for crawling.
BILIBILI_COOKIE=

# Lower page counts and a larger delay reduce rate-limit risk.
BILIBILI_VIDEO_PAGES=1
BILIBILI_DYNAMIC_PAGES=1
BILIBILI_PAGE_SIZE=10
BILIBILI_REQUEST_DELAY_MS=15000
BILIBILI_REQUEST_JITTER_MS=5000
BILIBILI_ACCOUNT_DELAY_MS=60000
BILIBILI_SCAN_MONTHS=18
